# Copy to .env.local for local development (never committed) and set the same
# variables in your host's environment settings for production.

# Optional: enables the Beam Analytics script (app/components/analytics.tsx).
# Leave unset to skip loading it entirely.
NEXT_PUBLIC_BEAM_TOKEN=

# Contact form (app/contact/actions.ts). All three are required for it to send;
# if any is missing the form shows a "couldn't send" error and logs why.

# Secret Resend API key, from https://resend.com/api-keys ("Sending access" is
# enough). Server-only — never give it a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
# Inbox that receives contact form messages (same name as on karunatech.ca).
# Replying to one goes straight to the visitor, via the Reply-To header.
OWNER_EMAIL=
# "From" address on those emails. Must be on a domain verified in Resend
# (https://resend.com/domains); a display name is optional, e.g.
# Contact form <contact@your-verified-domain.com>
CONTACT_FROM_EMAIL=
